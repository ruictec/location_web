# 环境变量示例文件（不会被版本控制追踪），请复制为 .env 或 .env.local 使用
# 开发环境请使用 .env.local，生产环境请使用 .env

# ==================== 核心服务配置 ====================

# 后端API基础地址（必须配置）
# 开发环境示例：http://localhost:14001/v1 或 http://192.168.2.30:14001/v1
# 生产环境示例：https://your-domain.com:14001/v1
# 本地开发推荐使用相对路径 /v1，由 webpack 代理转发（见 API_PROXY_TARGET）
VUE_APP_API_BASE=/v1

# WebSocket基础地址（必须配置）
# 开发环境示例：ws://localhost:14001/websocket
# 生产环境示例：wss://your-domain.com:14001/websocket
VUE_APP_WS_BASE=ws://localhost:14001/websocket

# ==================== 静态资源配置 ====================

# 静态资源服务地址（角色图片、文件上传等）
VUE_APP_ASSET_BASE=https://your-domain.com:8079

# 在线文档地址（导航栏中的在线文档和常见问题）
VUE_APP_DOC_BASE=https://your-domain.com:8078

# 帮助文档地址（菜单中的帮助文档）
VUE_APP_HELP_BASE=https://your-domain.com:8079

# ==================== 地图服务配置 ====================

# 室外地图底图提供商：tianditu（天地图）或 osm（OpenStreetMap）
# 也可在 static/config.js 中配置同名项；外部非空时优先于本文件（部署后改 dist/static/config.js 无需重新打包）
VUE_APP_MAP_PROVIDER=tianditu

# 天地图 API Key（在 https://www.tianditu.gov.cn/ 申请，中文环境使用天地图时必填）
# 双源：项目内用本变量；部署后覆盖可改 static/config.js 的 VUE_APP_TIANDITU_KEY（留空则回退到此处）
VUE_APP_TIANDITU_KEY=your_tianditu_key_here

# 地图瓦片URL模板（OSM 回退方案，包含{z}/{x}/{y}占位符）
VUE_APP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# 蜂鸟地图图片资源地址（3D地图相关）
VUE_APP_FENGMAP_IMG_BASE=https://developer.fengmap.com/fmAPI/images

# 蜂鸟 3D 离线包（跟前端站点走，与后端 API 无关）
# 默认：/data/{mapID}.fmap 、 /data/theme/{themeID}
# 部署时由 nginx 提供这些静态目录；仅在路径不同时才覆盖
# VUE_APP_FENGMAP_MAP_URL=/data/
# VUE_APP_FENGMAP_THEME_URL=/data/theme/

# ==================== 第三方服务配置 ====================

# MQTT服务器地址（实时消息推送）
VUE_APP_MQTT_BROKER_URL=tcp://mqtt.your-domain.com:1883

# 百度统计配置（可选，开源项目建议关闭）
VUE_APP_ENABLE_BAIDU_ANALYTICS=false
VUE_APP_BAIDU_HM_ID=

# ==================== 开发环境代理配置 ====================

# 开发环境代理目标地址（用于webpack dev server代理）
# 注意：这个变量只在开发环境使用，用于代理API请求
# API_PROXY_TARGET=http://localhost:14001/v1/
# API_PROXY_TARGET=https://location.rctiot.com:14001/v1
