{
  "name": "location-web-platform",
  "version": "1.0.0",
  "description": "A Vue.js 3 based indoor location and map management platform",
  "author": "ruictec",
  "license": "MIT",
  "private": false,
  "homepage": "https://github.com/ruictec/location_web#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruictec/location_web.git"
  },
  "bugs": {
    "url": "https://github.com/ruictec/location_web/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "indoor-location",
    "map-management",
    "fengmap",
    "openlayers",
    "location-tracking",
    "gis"
  ],
  "scripts": {
    "dev": "vite --port 8080",
    "start": "npm run dev",
    "build": "vite build",
    "preview": "vite preview --port 8080",
    "audit": "npm audit --registry https://registry.npmjs.org/",
    "audit:fix": "npm audit fix --registry https://registry.npmjs.org/",
    "outdated": "npm outdated",
    "install:legacy": "npm install --legacy-peer-deps",
    "clean": "rm -rf node_modules package-lock.json",
    "reinstall": "npm run clean && npm run install:legacy"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "@kjgl77/datav-vue3": "1.7.4",
    "axios": "1.7.9",
    "echarts": "5.5.1",
    "element-plus": "2.8.8",
    "express": "4.18.2",
    "fengmap": "3.1.4",
    "file-saver": "2.0.5",
    "jquery": "3.5.1",
    "lib-flexible": "0.3.2",
    "mitt": "3.0.1",
    "nprogress": "0.2.0",
    "ol": "6.4.3",
    "qs.js": "0.1.12",
    "screenfull": "5.0.2",
    "stats.js": "0.17.0",
    "stompjs": "2.3.3",
    "three": "0.150.1",
    "three-orbitcontrols": "2.110.3",
    "v-scale-screen": "2.3.0",
    "velocity-animate": "2.0.6",
    "vue": "3.4.38",
    "vue-axios": "3.5.2",
    "vue-fullscreen": "3.1.3",
    "vue-i18n": "9.14.2",
    "vue-lazyload": "3.0.0",
